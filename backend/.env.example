DATABASE_URL=postgresql+asyncpg://openetrm:openetrm@localhost:5432/openetrm
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# ENVIRONMENT defaults to "production" if unset -- secure by default, since forgetting
# to set it is the common failure mode, not the rare one. In "production" (the default)
# the app refuses to boot with a missing/default/short JWT_SECRET_KEY (see
# app.core.config._validate_secrets and ARCHITECTURE.md's "Fail-fast secret handling"
# section). Set ENVIRONMENT=development for local work so you don't need a real secret
# yet -- but generate and set a real JWT_SECRET_KEY (`openssl rand -hex 32`) below the
# moment this is reachable by anyone else.
ENVIRONMENT=development
# JWT_SECRET_KEY=<run: openssl rand -hex 32>

# Enterprise SSO (Entra ID / any OIDC provider) -- optional, off unless OIDC_ISSUER is
# set. See ARCHITECTURE.md's "Enterprise SSO" section and INTEGRATIONS.md.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=<your API's Application ID URI or client ID, from the Entra ID app registration>
# OIDC_JWKS_URL=  # optional override; defaults to <issuer>/discovery/v2.0/keys for Entra ID issuers
